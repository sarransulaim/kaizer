# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development points at the Postgres 18 instance on this machine.
# On Railway this is injected automatically from the Postgres service — use the
# private (internal) URL so traffic never leaves Railway's network.
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/kaizr_dev"

# ---------------------------------------------------------------------------
# Web push (VAPID)
# ---------------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:sulaimsarran@gmail.com"

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Shared secret required by /api/cron/* so the prep scheduler can't be
# triggered by anyone who guesses the URL.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build absolute URLs in push notification payloads.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Staff access
# ---------------------------------------------------------------------------
# The office side of the app (orders, analytics, payroll, settings) sits behind
# one shared passcode. /kitchen stays open so the wall tablet and the workers'
# phones need no login.
#
# AUTH_SECRET signs the session cookie — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
APP_PASSCODE=""
